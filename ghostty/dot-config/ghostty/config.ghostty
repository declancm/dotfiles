theme = Gruvbox Dark

macos-option-as-alt = left

# For coding agent TUIs
keybind = shift+enter=text:\n

# For Neovim unnamedplus clipboard
clipboard-read = allow

# Budget tmux Control Mode
keybind = super+t=text:\x02c
keybind = super+d=text:\x02%
keybind = super+shift+d=text:\x02"
keybind = super+w=text:\x02x
keybind = super+shift+enter=text:\x02z
keybind = super+]=text:\x02o
keybind = super+[=text:\x02O
keybind = super+digit1=text:\x021
keybind = super+digit2=text:\x022
keybind = super+digit3=text:\x023
keybind = super+digit4=text:\x024
keybind = super+digit5=text:\x025
keybind = super+digit6=text:\x026
keybind = super+digit7=text:\x027
keybind = super+digit8=text:\x028
keybind = super+digit9=text:\x029
